# Copy to .env and use with: tgmem --env-file .env <command>
# Variables already set in the environment take precedence over this file.

# --- storage ---------------------------------------------------------------
TGMEM_DB=memory.db
TGMEM_VAULT=vault

# --- embeddings (optional) -------------------------------------------------
# auto: use the OpenAI-compatible endpoint when an API key is set, otherwise
#       search with keywords + graph only. Other values: none, hash, openai.
TGMEM_EMBEDDER=auto
TGMEM_EMBED_API_KEY=
TGMEM_EMBED_BASE_URL=https://api.openai.com/v1
TGMEM_EMBED_MODEL=text-embedding-3-small
# Shorter vectors for models that support it (smaller index, faster search)
TGMEM_EMBED_DIMENSIONS=
TGMEM_EMBED_TIMEOUT=10
# Dimension of the offline hashing embedder (TGMEM_EMBEDDER=hash)
TGMEM_HASH_DIM=256

# --- identity and time -------------------------------------------------------
# Country code for phone numbers written without one, e.g. 1 or 44
TGMEM_DEFAULT_COUNTRY_CODE=
# Zone used to read dates you type without an offset (stored times are always UTC)
TGMEM_TIMEZONE=UTC

# --- examples/llm_assistant.py (reads these from the process environment) ---
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
